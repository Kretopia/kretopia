# Copy this file to .env (or .env.local) and fill in real values from
# your Supabase project dashboard (Settings → API). Everything here is
# client-exposed (Vite only inlines VITE_-prefixed vars into the bundle),
# so only ever put publishable/anon-level values in this file -- never a
# service_role key or any other server-side secret.

# Required -- the app crashes at boot ("supabaseUrl is required") without
# these two. Project ref for this repo is kwmcocsitwssrtzkdojh, so the URL
# is fixed; the publishable (anon) key must be copied from the dashboard.
VITE_SUPABASE_URL=https://kwmcocsitwssrtzkdojh.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=kwmcocsitwssrtzkdojh

# Optional -- safe to leave blank for local dev; each degrades gracefully
# when unset (no error reporting, no push notifications, canonical-URL
# fallback respectively).
VITE_SENTRY_DSN=
VITE_VAPID_PUBLIC_KEY=
VITE_SITE_URL=http://localhost:8080

# Optional build-time flag, only read by vite.config.ts -- leave unset
# unless you're specifically testing static social-share page generation.
VITE_GENERATE_STATIC_SOCIAL_PAGES=false
